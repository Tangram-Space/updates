<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key><string>en</string>
  <key>CFBundleLocalizations</key>
  <array><string>en</string><string>en-US</string><string>en-GB</string><string>en-CA</string><string>en-AU</string><string>es</string><string>es-ES</string><string>es-MX</string><string>es-AR</string><string>es-419</string></array>
  <key>CFBundleDisplayName</key><string>AirPlay</string>
  <key>CFBundleExecutable</key><string>uxplay</string>
  <key>CFBundleIdentifier</key><string>local.chevy.airplay</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleName</key><string>AirPlay</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>@AIRPLAY_VERSION@</string>
  <key>CFBundleVersion</key><string>@AIRPLAY_BUILD@</string>
  <key>LSMinimumSystemVersion</key><string>11.0</string>
  <key>LSUIElement</key><true/>
  <key>LSBackgroundOnly</key><false/>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSPrincipalClass</key><string>AirPlayApplication</string>
  <key>SURequireSignedFeed</key><true/>
  <key>SUVerifyUpdateBeforeExtraction</key><true/>
  <key>SUEnableAutomaticChecks</key><false/>
  <key>SUAutomaticallyUpdate</key><false/>
  <key>SUAllowsAutomaticUpdates</key><false/>
</dict>
</plist>

