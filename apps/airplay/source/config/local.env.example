# Optional: copy this file to config/local.env to select other existing paths.
# That local file is ignored by Git. Do not add account credentials here.
# Empty values reuse the known prototype tools/dependencies when available.
AIRPLAY_CMAKE=""
AIRPLAY_DEPS_PREFIX=""
AIRPLAY_GSTREAMER_ROOT="/Library/Frameworks/GStreamer.framework/Versions/1.0"
# Optional pinned official archive. If empty, the bootstrap downloads the fixed URL.
AIRPLAY_SPARKLE_ARCHIVE=""

# Optional existing UxPlay Git checkout; it is read at the pinned commit.
# When empty, reuses the historical prototype checkout if it contains the pinned
# commit; otherwise the build fetches only that commit from upstream.
AIRPLAY_UPSTREAM_REPO=""

# Optional alternative .icns. Empty uses the original application icon.
AIRPLAY_ICON_FILE=""

